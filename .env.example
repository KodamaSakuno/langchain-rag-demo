CHAT_API_KEY=sk-xxx
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash

EMBEDDING_MODEL=BAAI/bge-m3
# hf = 本地 HuggingFace（默认）；api = OpenAI 兼容接口
# EMBEDDING_BACKEND=api
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://ai.gitee.com/v1

# 可选 hybrid（向量+BM25 融合）。实测（data/eval_report_hybrid.json）：中文查询对英文文档场景下
# Recall@5 反而从 91.67% 降到 87.50%，词法匹配引入噪声，不建议开启
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# pgvector 后端（向量与记忆可共用一个 Postgres，适合部署/serverless）
# 注意：pgvector 分数为余弦相似度，阈值尺度与 chroma 不同，建议 RETRIEVAL_SCORE_THRESHOLD=0.5
# VECTOR_STORE_BACKEND=pgvector
PG_CONNECTION=postgresql+psycopg:///rag_demo

# 记忆后端：memory（进程内存，重启丢失）/ postgres（跨重启保留）
MEMORY_BACKEND=memory

# 多 Agent 协作：1 = 主 Agent 输出前由审校员 subagent 事实核查（每问多 1~2 次 LLM 调用）
# MULTI_AGENT=1

RETRIEVAL_SCORE_THRESHOLD=0.3

# 检索前用 LLM 把问题改写成英文技术查询（跨语言提升召回，每次查询多一次 LLM 调用）
QUERY_REWRITE=0
